---
import { about } from "../data/portfolio";
---

<section id="about" data-section class="border-b border-ink px-5 py-12 md:px-8 md:py-20">
  <div class="mx-auto max-w-[1500px]">
    <div class="section-label mb-8 md:mb-12">
      <span aria-hidden="true">01</span>
      <h2 class="mono-label">{about.title}</h2>
      <span class="ml-auto text-ink/90">WHO</span>
    </div>

    <p class="display display-l max-w-[24ch] text-balance" data-web>{about.lead}</p>

    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-7 flex flex-col gap-5">
        {about.paragraphs.map((p) => (
          <p class="max-w-[62ch] text-[15px] leading-[1.6] md:text-base">{p}</p>
        ))}
      </div>

      <dl class="md:col-span-4 md:col-start-9 flex flex-col gap-5 border-t border-ink pt-5">
        {about.facts.map((f) => (
          <div class="flex flex-col gap-1 border-b hairline pb-4">
            <dt class="mono-label text-ink/90">{f.key}</dt>
            <dd class="text-[14px] leading-snug md:text-[15px]">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
