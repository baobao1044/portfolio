---
import { hero } from "../data/portfolio";

const [first, second, third] = hero.stats;
---

<section
  id="hero"
  data-section
  class="border-b border-ink px-5 pb-12 pt-10 md:px-8 md:pb-16 md:pt-14"
>
  <div class="mx-auto max-w-[1500px]">
    <div
      class="mb-8 flex flex-wrap items-baseline justify-between gap-3 border-b hairline pb-3 md:mb-12"
    >
      <span class="mono-label">{hero.eyebrow}</span>
      <span class="mono-label text-ink/90">PORTFOLIO / 2026</span>
    </div>

    <h1 class="display display-xl" data-web>
      <span class="block">{hero.headlineTop}</span>
      <span class="block">{hero.headlineBottom}</span>
    </h1>

    <div class="mt-10 grid gap-8 md:mt-16 md:grid-cols-12 md:gap-6">
      <p class="md:col-span-6 md:col-start-1 max-w-[46ch] text-[15px] leading-[1.55] md:text-base">
        {hero.summary}
      </p>

      <div class="md:col-span-3 md:col-start-8 flex flex-col gap-3">
        <a
          href={hero.ctaPrimary.href}
          class="mono-label inline-flex items-center gap-3 border border-ink bg-ink px-4 py-3 text-bone transition-colors hover:bg-transparent hover:text-ink"
        >
          {hero.ctaPrimary.label}
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href={hero.ctaSecondary.href}
          class="mono-label inline-flex items-center gap-3 border border-ink px-4 py-3 transition-colors hover:bg-ink hover:text-bone"
        >
          {hero.ctaSecondary.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <dl
        class="mt-2 flex flex-wrap gap-x-6 gap-y-4 md:col-span-2 md:col-start-11 md:mt-0 md:flex-col md:gap-4"
      >
        <div data-web>
          <dt class="mono-label text-ink/90">{first.label}</dt>
          <dd class="display display-m tabular-nums">{first.value}</dd>
        </div>
        <div>
          <dt class="mono-label text-ink/90">{second.label}</dt>
          <dd class="display display-m tabular-nums">{second.value}</dd>
        </div>
        <div>
          <dt class="mono-label text-ink/90">{third.label}</dt>
          <dd class="display display-m tabular-nums">{third.value}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
