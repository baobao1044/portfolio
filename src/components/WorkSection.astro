---
import { projects } from "../data/portfolio";

const groups = [
  { key: "AI", code: "DOM.01", label: "AI & model research" },
  { key: "COMPILERS", code: "DOM.02", label: "Compilers & runtimes" },
  { key: "SYSTEMS", code: "DOM.03", label: "Systems & graphics" },
  { key: "TOOLS", code: "DOM.04", label: "Tools & security" },
] as const;
---

<section id="work" data-section class="border-b-2 border-ink px-5 py-14 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1500px]">
    <div class="section-label mb-10 md:mb-14">
      <span class="section-index-chip" aria-hidden="true">02</span>
      <h2 class="mono-label font-bold">Work</h2>
      <span class="ml-auto font-bold">{projects.length} BUILDS · ALL PUBLIC</span>
    </div>

    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <p class="display display-l kinetic-rise max-w-[22ch] text-balance" data-web>
        Ten repositories, each with its own measurements.
      </p>
      <p class="mono-label border border-ink bg-ink px-3.5 py-2 font-bold text-bone self-start md:self-auto">
        CLICK ANY BUILD TO INSPECT ARCHITECTURE ↓
      </p>
    </div>

    <div class="mt-12 flex flex-col gap-12 md:mt-16 md:gap-16">
      {
        groups.map((g) => {
          const items = projects.filter((p) => p.domain === g.key);
          if (!items.length) return null;
          return (
            <div class="flex flex-col">
              <div class="surface-ink flex items-center justify-between border-b-2 border-ink px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="bg-red px-2 py-0.5 font-mono text-[9px] font-bold tracking-[0.2em] text-ink">
                    {g.code}
                  </span>
                  <h3 class="mono-label font-bold text-bone">{g.label}</h3>
                </div>
                <span class="mono-label font-bold text-red">
                  0{items.length} {items.length === 1 ? "REPO" : "REPOS"}
                </span>
              </div>

              <ul class="flex flex-col">
                {items.map((p) => (
                  <li>
                    <details class="work-row">
                      <summary class="row-grid grid grid-cols-12 items-center gap-3 px-2 py-5 md:gap-4 md:py-6">
                        <span class="row-index col-span-2 sm:col-span-1 mono-label font-bold">
                          /{p.index}
                        </span>

                        <h4 class="col-span-7 sm:col-span-8 display display-row break-words md:col-span-4">
                          {p.title}
                        </h4>

                        <span class="row-sub hidden md:col-span-5 md:block text-[14px] leading-snug">
                          {p.oneLiner}
                        </span>

                        <span class="col-span-3 sm:col-span-3 flex items-center justify-end gap-2.5 md:col-span-2">
                          <span
                            class="status-chip mono-label hidden sm:inline-flex"
                            data-status={p.status}
                          >
                            {p.status.toUpperCase()}
                          </span>
                          <span class="work-plus mono-label text-sm leading-none" aria-hidden="true">
                            +
                          </span>
                        </span>

                        <span class="row-sub col-span-12 mt-1.5 text-[13px] leading-snug md:hidden">
                          {p.oneLiner}
                        </span>
                      </summary>

                      <div class="work-drawer surface-ink grid gap-8 px-5 py-8 md:grid-cols-12 md:gap-8 md:px-8">
                        <div class="flex flex-col gap-5 md:col-span-7">
                          <div class="flex items-center gap-3">
                            <span class="mono-label font-bold text-red">ARCHITECTURE BRIEF</span>
                            <span class="h-px flex-1 bg-bone/15" aria-hidden="true" />
                          </div>

                          <p class="max-w-[68ch] text-[15px] leading-[1.65] text-bone/95">
                            {p.description}
                          </p>

                          <ul class="grid gap-2 sm:grid-cols-2">
                            {p.facts.map((f, fi) => (
                              <li class="flex items-start gap-2.5 border border-bone/15 bg-bone/5 p-3 text-[13px] leading-snug text-bone">
                                <span aria-hidden="true" class="mono-label font-bold text-red">
                                  0{fi + 1}
                                </span>
                                <span>{f}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        <div class="flex flex-col justify-between gap-6 md:col-span-4 md:col-start-9">
                          <div>
                            <p class="mono-label mb-3 font-bold text-red">STACK & PRIMITIVES</p>
                            <ul class="flex flex-wrap gap-2">
                              {p.stack.map((s) => (
                                <li class="mono-label border border-bone/30 bg-bone/5 px-2.5 py-1.5 text-[9px] font-bold tracking-[0.18em] text-bone">
                                  {s}
                                </li>
                              ))}
                            </ul>
                          </div>

                          <a
                            href={p.repo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="brutal-btn brutal-btn--red mono-label inline-flex items-center justify-between gap-3 px-4 py-3.5 break-all"
                          >
                            <span>{p.repo.replace("https://github.com/", "github.com/")}</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        </div>
                      </div>
                    </details>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
