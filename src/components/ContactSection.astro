---
import { contact, site } from "../data/portfolio";
---

<section id="contact" data-section class="px-5 py-14 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1500px]">
    <div class="section-label mb-8 md:mb-12">
      <span aria-hidden="true">05</span>
      <h2 class="mono-label">{contact.title}</h2>
      <span class="ml-auto text-ink/90">OPEN</span>
    </div>

    <p class="display display-l max-w-[20ch] text-balance" data-web>
      Send the hard problem.
    </p>

    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-6 flex flex-col gap-6">
        <p class="max-w-[52ch] text-[15px] leading-[1.6] md:text-base">{contact.intro}</p>

        <a
          href={`mailto:${contact.email}`}
          class="display display-m link-underline self-start break-all lowercase"
        >
          {contact.email}
        </a>
      </div>

      <div class="md:col-span-4 md:col-start-9 flex flex-col gap-4">
        <p class="mono-label border-b border-ink pb-2 text-ink/90">Elsewhere</p>
        <ul class="flex flex-col gap-2">
          {
            contact.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mono-label link-underline inline-flex items-baseline gap-2"
                >
                  <span>{l.label}</span>
                  <span aria-hidden="true" class="text-ink/90">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mono-label mt-4 text-ink/90">{site.company} · {site.role}</p>
      </div>
    </div>
  </div>
</section>
