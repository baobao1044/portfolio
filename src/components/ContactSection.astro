---
import { contact, site } from "../data/portfolio";
---

<section id="contact" data-section class="px-5 py-16 md:px-8 md:py-28">
  <div class="mx-auto max-w-[1500px]">
    <div class="section-label mb-10 md:mb-14">
      <span class="section-index-chip" aria-hidden="true">05</span>
      <h2 class="mono-label font-bold">{contact.title}</h2>
      <span class="ml-auto font-bold">OPEN // DIRECT CHANNEL</span>
    </div>

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="flex flex-col justify-between gap-8 lg:col-span-7">
        <div>
          <p class="display display-l kinetic-rise max-w-[20ch] text-balance" data-web>
            Send the hard problem.
          </p>
          <p class="mt-6 max-w-[52ch] text-[15px] font-medium leading-[1.65] md:text-[17px]">
            {contact.intro}
          </p>
        </div>

        <div class="flex flex-col gap-4 border-t-2 border-ink pt-6">
          <span class="mono-label font-bold">PRIMARY DISPATCH</span>
          <a
            href={`mailto:${contact.email}`}
            class="display display-m link-underline self-start break-all lowercase"
          >
            {contact.email}
          </a>

          <div class="mt-2 flex flex-wrap gap-3">
            <a
              href={`mailto:${contact.email}`}
              class="brutal-btn brutal-btn--primary mono-label inline-flex items-center gap-3 px-5 py-3.5 font-bold"
            >
              <span>Write an email</span>
              <span aria-hidden="true">→</span>
            </a>

            <button
              id="copy-email-btn"
              type="button"
              data-email={contact.email}
              class="brutal-btn brutal-btn--secondary mono-label inline-flex items-center gap-2.5 px-5 py-3.5 font-bold"
            >
              <span data-copy-label>Copy address</span>
              <span aria-hidden="true">⧉</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Obsidian Network / Profiles Terminal -->
      <div
        class="surface-ink telemetry-card flex flex-col justify-between gap-8 p-6 md:p-8 lg:col-span-5"
      >
        <div>
          <div class="mb-5 flex items-center justify-between border-b border-bone/15 pb-3">
            <span class="mono-label font-bold text-red">ELSEWHERE // VERIFIED</span>
            <span class="status-dot" aria-hidden="true"></span>
          </div>

          <ul class="flex flex-col gap-3">
            {
              contact.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-between border border-bone/20 bg-bone/5 px-4 py-4 text-bone transition-colors hover:border-red hover:bg-red hover:text-ink"
                  >
                    <span class="display text-2xl tracking-wide">{l.label}</span>
                    <span
                      aria-hidden="true"
                      class="mono-label font-bold text-red group-hover:text-ink"
                    >
                      ↗
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-t border-bone/15 pt-4">
          <p class="mono-label text-red">{site.company}</p>
          <p class="mt-1 text-[14px] text-bone/90">{site.role}</p>
        </div>
      </div>
    </div>
  </div>
</section>
