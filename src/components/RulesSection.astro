---
import { principles } from "../data/portfolio";
---

<section id="rules" data-section class="border-b-2 border-ink px-5 py-14 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1500px]">
    <div class="section-label mb-10 md:mb-14">
      <span class="section-index-chip" aria-hidden="true">03</span>
      <h2 class="mono-label font-bold">Rules</h2>
      <span class="ml-auto font-bold">HOW THE WORK GETS MADE</span>
    </div>

    <ul class="grid gap-5 md:grid-cols-2 md:gap-6">
      {
        principles.map((p) => (
          <li
            data-web
            class="rule-card kinetic-rise flex flex-col justify-between gap-6 p-6 md:p-9"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="rule-num mono-label border border-current bg-ink px-2.5 py-1 font-bold text-red transition-colors">
                RULE // {p.number}
              </span>
              <span class="rule-ghost" aria-hidden="true">
                {p.number}
              </span>
            </div>

            <div class="flex flex-col gap-3">
              <h3 class="display display-m max-w-[18ch]">{p.title}</h3>
              <p class="rule-sub max-w-[48ch] text-[14px] leading-[1.65] md:text-[15px]">
                {p.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
