---
import "../styles/global.css";
import CursorWeb from "../components/ui/CursorWeb.astro";
import IntroOverlay from "../components/ui/IntroOverlay.astro";
import { site, navItems, contact, webLexicon } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props as Props;

const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL("https://baobao1044.github.io");
const canonical = new URL(Astro.url.pathname, origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author,
  url: canonical,
  jobTitle: site.role,
  email: `mailto:${contact.email}`,
  sameAs: contact.links.map((l) => l.href),
  description: site.description,
};
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#ff2400" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${base}favicon.svg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="relative font-sans text-ink">
    <IntroOverlay />

    <script type="application/json" id="web-lexicon" set:html={JSON.stringify(webLexicon)} />

    <!-- Living Crimson Field: micro-matrix + interactive spotlight + tactile grain -->
    <div class="crimson-atmosphere" aria-hidden="true"></div>
    <div class="crimson-grain" aria-hidden="true"></div>

    <!-- Decorative scroll-drawn & pointer-reactive CAD web -->
    <CursorWeb />

    <div class="relative z-10 flex min-h-screen flex-col">
      <header class="site-header">
        <nav
          class="mx-auto flex max-w-[1500px] items-center justify-between gap-4 px-5 py-4 md:px-8 md:py-4"
          aria-label="Primary"
        >
          <a
            href={`${base}`}
            class="inline-flex items-center gap-2.5 bg-ink px-3 py-1.5 text-bone transition-transform hover:-translate-y-0.5"
          >
            <span class="inline-block h-2 w-2 bg-red" aria-hidden="true"></span>
            <span class="mono-label font-bold tracking-[0.32em]">BAOBG</span>
          </a>

          <ul class="hidden items-center gap-2 lg:gap-4 md:flex">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="mono-label nav-pill font-medium"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="hidden items-center gap-4 md:flex">
            <span class="mono-label hidden items-center gap-2 lg:inline-flex" aria-hidden="true">
              <span class="status-dot"></span>
              <span>SYS · ONLINE</span>
            </span>
            <a
              href={`mailto:${contact.email}`}
              class="mono-label border border-ink px-3 py-1.5 font-bold transition-colors hover:bg-ink hover:text-bone"
            >
              {contact.email}
            </a>
          </div>

          <button
            id="mobile-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-panel"
            class="mono-label border border-ink bg-ink px-3 py-1.5 font-bold text-bone md:hidden"
          >
            Menu
          </button>
        </nav>

        <div id="mobile-panel" class="mobile-panel surface-ink md:hidden" hidden>
          <ul class="flex flex-col gap-1 px-5 py-6">
            {navItems.map((item, i) => (
              <li class="border-b border-bone/15">
                <a
                  href={item.href}
                  class="mobile-link flex items-baseline justify-between py-3 text-bone transition-colors hover:text-red"
                >
                  <span class="display display-m">{item.label}</span>
                  <span class="mono-label text-red" aria-hidden="true">0{i + 1}</span>
                </a>
              </li>
            ))}
            <li class="pt-5">
              <a href={`mailto:${contact.email}`} class="mono-label text-red link-underline">
                {contact.email}
              </a>
            </li>
          </ul>
        </div>

        <div class="scroll-laser" aria-hidden="true"></div>
      </header>

      <main class="flex-grow">
        <slot />
      </main>

      <footer class="surface-ink border-t-2 border-ink px-5 py-12 md:px-8 md:py-16">
        <div class="mx-auto max-w-[1500px]">
          <div class="flex flex-col justify-between gap-8 border-b border-bone/15 pb-10 md:flex-row md:items-end">
            <div>
              <p class="mono-label mb-3 text-red">END OF TRANSMISSION // EDITION 2026</p>
              <p class="display text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.88] text-bone">
                BAOBG <span class="text-red">/</span> CPU FIRST.
              </p>
            </div>

            <a
              href="#hero"
              class="brutal-btn brutal-btn--red mono-label inline-flex items-center gap-3 self-start px-5 py-3 md:self-auto"
            >
              <span>Return to top</span>
              <span aria-hidden="true">↑</span>
            </a>
          </div>

          <div class="mt-8 flex flex-col gap-3 md:flex-row md:items-baseline md:justify-between">
            <p class="mono-label text-bone">© {new Date().getFullYear()} {site.author}</p>
            <p class="mono-label text-bone/80">{site.role} · {site.company}</p>
            <p class="mono-label text-red">No trackers · No analytics · Zero runtime bloat</p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import { initIntro } from "../lib/intro";
      import { initCursorWeb } from "../lib/cursorWeb";
      import { initMotion } from "../lib/motion";

      const LEXICON: string[] = JSON.parse(
        document.getElementById("web-lexicon")?.textContent ?? "[]",
      );

      initIntro();

      const canvas = document.getElementById("cursor-web") as HTMLCanvasElement | null;
      if (canvas) initCursorWeb(canvas, LEXICON);

      initMotion();

      const toggle = document.getElementById("mobile-toggle");
      const panel = document.getElementById("mobile-panel");
      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? "Close" : "Menu";
        };
        toggle.addEventListener("click", () => {
          setOpen(panel.hidden);
        });
        panel.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) setOpen(false);
        });
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !panel.hidden) {
            setOpen(false);
            (toggle as HTMLButtonElement).focus();
          }
        });
        window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
          if (e.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
