---
import "../styles/global.css";
import CursorWeb from "../components/ui/CursorWeb.astro";
import IntroOverlay from "../components/ui/IntroOverlay.astro";
import { site, navItems, contact, webLexicon } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props as Props;

// Canonical and sitemap URLs must respect the GitHub Pages sub-path in `base`.
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL("https://baobao1044.github.io");
const canonical = new URL(Astro.url.pathname, origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author,
  url: canonical,
  jobTitle: site.role,
  email: `mailto:${contact.email}`,
  sameAs: contact.links.map((l) => l.href),
  description: site.description,
};
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <!-- Set before first paint: CSS uses `.js` to decide whether the intro
         overlay may be shown at all. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#ff2400" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${base}favicon.svg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="relative font-sans text-ink">
    <IntroOverlay />

    <!-- Words the web draws behind each section. Serialised here so the canvas
         module reads them synchronously at boot. -->
    <script type="application/json" id="web-lexicon" set:html={JSON.stringify(webLexicon)} />

    <!-- Decorative scroll-drawn web. Fixed, z-0, sits under every section. -->
    <CursorWeb />

    <div class="relative z-10 flex min-h-screen flex-col">
      <header class="site-header">
        <nav
          class="mx-auto flex max-w-[1500px] items-baseline justify-between gap-6 px-5 py-5 md:px-8 md:py-6"
          aria-label="Primary"
        >
          <a href={`${base}`} class="mono-label font-bold tracking-[0.34em] link-underline">
            BAOBG
          </a>

          <ul class="hidden items-baseline gap-7 md:flex">
            {navItems.map((item) => (
              <li>
                <a href={item.href} class="mono-label link-underline hover:text-ink/90">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <a
            href={`mailto:${contact.email}`}
            class="mono-label hidden text-ink/90 transition-opacity hover:opacity-100 md:block link-underline"
          >
            {contact.email}
          </a>

          <button
            id="mobile-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-panel"
            class="mono-label md:hidden"
          >
            Menu
          </button>
        </nav>

        <div id="mobile-panel" class="mobile-panel md:hidden" hidden>
          <ul class="flex flex-col gap-1 px-5 pb-8">
            {navItems.map((item, i) => (
              <li class="border-t hairline">
                <a
                  href={item.href}
                  class="mobile-link flex items-baseline justify-between py-3"
                >
                  <span class="display display-m">{item.label}</span>
                  <span class="mono-label text-ink/90">0{i + 1}</span>
                </a>
              </li>
            ))}
            <li class="border-t hairline pt-4">
              <a href={`mailto:${contact.email}`} class="mono-label link-underline">
                {contact.email}
              </a>
            </li>
          </ul>
        </div>
      </header>

      <main class="flex-grow">
        <slot />
      </main>

      <footer class="border-t border-ink px-5 py-8 md:px-8">
        <div
          class="mx-auto flex max-w-[1500px] flex-col gap-3 md:flex-row md:items-baseline md:justify-between"
        >
          <p class="mono-label">© {new Date().getFullYear()} {site.author}</p>
          <p class="mono-label text-ink/90">{site.role} · {site.company}</p>
          <p class="mono-label text-ink/90">No trackers · No analytics · Static HTML</p>
        </div>
      </footer>
    </div>

    <script>
      import { initIntro } from "../lib/intro";
      import { initCursorWeb } from "../lib/cursorWeb";
      // Serialised at build time so the client bundle carries no data import.
      const LEXICON: string[] = JSON.parse(document.getElementById("web-lexicon")?.textContent ?? "[]");

      initIntro();

      const canvas = document.getElementById("cursor-web") as HTMLCanvasElement | null;
      if (canvas) initCursorWeb(canvas, LEXICON);

      const toggle = document.getElementById("mobile-toggle");
      const panel = document.getElementById("mobile-panel");
      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? "Close" : "Menu";
        };
        toggle.addEventListener("click", () => {
          setOpen(panel.hidden);
        });
        panel.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) setOpen(false);
        });
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !panel.hidden) {
            setOpen(false);
            (toggle as HTMLButtonElement).focus();
          }
        });
        window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
          if (e.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
